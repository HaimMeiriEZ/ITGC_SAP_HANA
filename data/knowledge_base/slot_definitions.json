{
  "_schema_version": 1,
  "_description": "הגדרות slot ליצואי SAP HANA DB",
  "slots": {
    "USERS": {
      "label_he": "משתמשים (טבלת USERS)",
      "filename_patterns": ["*user*", "*USERS*", "hana usert*"],
      "required_columns": ["USER_NAME"],
      "required_any_groups": [["LAST_SUCCESSFUL_CONNECT", "LAST_SUCCESSFUL_CONNECT_DATE"]],
      "optional_columns": ["USER_DEACTIVATED", "IS_RESTRICTED_DETAILS", "LAST_INVALID_CONNECT_ATTEMPT"]
    },
    "M_PASSWORD_POLICY": {
      "label_he": "מדיניות סיסמאות (M_PASSWORD_POLICY)",
      "filename_patterns": ["*password*", "*M_PASSWORD_POLICY*"],
      "required_columns": ["PROPERTY", "VALUE"],
      "required_any_groups": [],
      "optional_columns": []
    },
    "GRANTED_PRIVILEGES": {
      "label_he": "הרשאות (GRANTED_PRIVILEGES)",
      "filename_patterns": ["*GRANTED_PRIV*", "*granted_priv*", "*privileges*"],
      "required_columns": ["GRANTEE", "PRIVILEGE"],
      "required_any_groups": [],
      "optional_columns": ["OBJECT_TYPE", "IS_VALID", "GRANTEE_TYPE"]
    },
    "EFFECTIVE_PRIVILEGE_GRANTEES": {
      "label_he": "הרשאות אפקטיביות (EFFECTIVE_PRIVILEGE_GRANTEES)",
      "filename_patterns": ["*EFFECTIVE_PRIVILEGE*", "*effective_privilege*", "*EFFECTIVE_PRIV*"],
      "required_columns": ["GRANTEE", "PRIVILEGE", "OBJECT_TYPE"],
      "required_any_groups": [],
      "optional_columns": ["GRANTEE_TYPE", "GRANTOR", "SCHEMA_NAME", "OBJECT_NAME", "IS_GRANTABLE", "IS_VALID"]
    },
    "GRANTED_ROLES": {
      "label_he": "הקצאות תפקידים (GRANTED_ROLES)",
      "filename_patterns": ["*role*", "*GRANTED_ROLES*"],
      "required_columns": [],
      "required_any_groups": [
        ["GRANTEE", "GRANTEE_NAME", "USER_NAME", "USER"],
        ["ROLE_NAME", "ROLE", "GRANTED_ROLE_NAME", "GRANTED_ROLE"]
      ],
      "optional_columns": ["GRANTEE_TYPE", "IS_GRANTED_BY_LDAP"]
    },
    "AUDIT_POLICIES": {
      "label_he": "מדיניות ניטור (AUDIT_POLICIES)",
      "filename_patterns": ["*AUDIT_POLIC*", "*audit_polic*"],
      "required_columns": ["AUDIT_POLICY_NAME", "IS_AUDIT_POLICY_ACTIVE"],
      "required_any_groups": [],
      "optional_columns": []
    },
    "AUDIT_TRAIL": {
      "label_he": "ראיות Audit (Audit Trail)",
      "filename_patterns": ["*AUDIT_TRAIL*", "*audit_trail*"],
      "required_columns": [],
      "required_any_groups": [
        ["ACTION", "ACTION_NAME", "EVENT_ACTION", "EVENT", "STATEMENT_STRING", "COMMAND_TEXT"]
      ],
      "optional_columns": []
    },
    "M_INIFILE_CONTENTS": {
      "label_he": "הקשחת תצורה (M_INIFILE_CONTENTS)",
      "filename_patterns": ["*INIFILE*", "*ini*"],
      "required_columns": [],
      "required_any_groups": [
        ["SECTION", "SECTION_NAME"],
        ["KEY", "KEY_NAME", "PARAMETER_NAME", "PROPERTY"],
        ["VALUE", "CONFIGURED_VALUE", "CURRENT_VALUE"]
      ],
      "optional_columns": ["FILE_NAME"]
    },
    "CONFIGURATION_PARAMETER_PROPERTIES": {
      "label_he": "מטא-דאטה פרמטרי תצורה (CONFIGURATION_PARAMETER_PROPERTIES)",
      "filename_patterns": ["*CONFIGURATION_PARAMETER*", "*parameter_properties*", "*CONFIG_PARAM*"],
      "required_columns": ["SECTION", "KEY", "DEFAULT_VALUE"],
      "required_any_groups": [],
      "optional_columns": ["DESCRIPTION", "DATA_TYPE_NAME", "INIFILE_NAMES", "RESTART_REQUIRED", "IS_READ_ONLY"]
    }
  }
}
